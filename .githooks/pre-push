#!/usr/bin/env bash
# Validates every commit about to be pushed, not just the last one.
# Server-side enforcement (branch protection) is unavailable on this plan, so this
# is the last gate before history leaves the machine. See CONTRIBUTING.md.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/scripts/check-commits.sh"
[ -x "$checker" ] || { echo "pre-push: missing $checker" >&2; exit 1; }

ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range="$local_sha"                            # new branch / unknown remote tip
  else
    range="${remote_sha}..${local_sha}"
  fi
  "$checker" "$range" || status=1
done

# Internal identifiers / credentials must not leave the machine either.
if ! "$repo_root/scripts/check-leaks.sh" >/dev/null 2>&1; then
  "$repo_root/scripts/check-leaks.sh" >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "pre-push: push rejected — fix the commits above before pushing." >&2
  exit 1
fi
